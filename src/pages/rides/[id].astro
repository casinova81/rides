---
import Layout from '../../layouts/Layout.astro';
import { loadRide } from '../../lib/db';
import {
  detailSubline,
  headlineTiles,
  secondaryStats,
  fastestWindows,
  splitRows,
} from '../../lib/ride-detail';
import { trackHeroSVG } from '../../lib/thumb';
import { chartSVG } from '../../lib/chart';
import { Track } from '../../lib/track';
import { SPEED_STEPS } from '../../lib/playback';
import { mapModes } from '../../lib/mapview';

// The ride detail page (tickets 4a + 4b): full stats for one ride, a live map
// hero with 2D-follow playback, and delete. Reads the per-ride payload from D1
// per request (dynamic — a freshly-uploaded ride is viewable with no rebuild).
// The static SVG route line is the pre-JS / map-load-failure fallback; the client
// controller upgrades the hero to a live map. Delete hits the Worker endpoint and
// lets records/totals self-heal on the next index read.
export const prerender = false;

const { id } = Astro.params;
const db = Astro.locals.runtime.env.DB;
const ride = id ? await loadRide(db, id) : null;

if (!ride) {
  Astro.response.status = 404;
}

const heroSvg = ride ? trackHeroSVG(ride.track.lat, ride.track.lon) : '';
const tiles = ride ? headlineTiles(ride) : [];
const secondary = ride ? secondaryStats(ride) : [];
const windows = ride ? fastestWindows(ride) : [];
const splits = ride ? splitRows(ride.splits) : [];
// The camera-mode toggle is the flat-mapped engine registry (issue 09), rendered
// server-side so the ordered mode list is the single source of truth. First = default.
const modes = mapModes();
// Elevation + speed charts (ticket 4d), rendered server-side from the same pure
// geometry the client re-derives to hit-test hover x → distance. Static without JS;
// the controller upgrades them with a synced cursor.
const eleChart = ride ? chartSVG(new Track(ride.track), 'elevation') : '';
const speedChart = ride ? chartSVG(new Track(ride.track), 'speed') : '';
---

<Layout title={ride ? `${ride.name} — Ride Tracker` : 'Ride not found'}>
  <main>
    {
      !ride ? (
        <div class="wrap">
          <section class="not-found">
            <h1>Ride not found</h1>
            <p class="sub">
              No ride with that id. <a href="/">Back to all rides</a>.
            </p>
          </section>
        </div>
      ) : (
        <>
          <div class="wrap wrap--top">
            <header class="detail-head">
              <h1>{ride.name}</h1>
              <p class="sub detail-sub">{detailSubline(ride)}</p>
            </header>
          </div>

          <div class="hero hero--bleed" id="ride-hero">
            <div class="hero__placeholder" set:html={heroSvg} />
            <div class="hero__map" id="map-hero" role="application" aria-label="Ride playback map" />
          </div>

          <div class="wrap wrap--bottom">
          <div class="playback" id="playback" hidden>
            <button class="pb-btn" id="pb-play" type="button" aria-label="Play">▶</button>
            <div class="pb-speeds" id="pb-speeds" role="group" aria-label="Playback speed">
              {
                SPEED_STEPS.map((s, i) => (
                  <button
                    class={`pb-speed${i === 1 ? ' active' : ''}`}
                    type="button"
                    data-speed={s}
                  >
                    {s}×
                  </button>
                ))
              }
            </div>
            <div class="pb-modes" id="pb-modes" role="group" aria-label="Camera mode">
              {
                modes.map((c, i) => (
                  <button
                    class={`pb-mode${i === 0 ? ' active' : ''}`}
                    type="button"
                    data-mode={c.mode.id}
                  >
                    {c.mode.label}
                  </button>
                ))
              }
            </div>
            <input
              class="pb-scrub"
              id="pb-scrub"
              type="range"
              min="0"
              max="1000"
              value="0"
              aria-label="Seek through the ride"
            />
            <span class="pb-time" id="pb-time" aria-live="off">0:00</span>
          </div>
          <script type="application/json" id="ride-track" is:inline set:html={JSON.stringify(ride.track)} />

          <section class="charts" id="ride-charts" aria-label="Elevation and speed">
            <figure class="chart" data-chart-kind="elevation">
              <figcaption class="chart__cap">
                <span class="chart__title">Elevation</span>
                <output class="chart__readout" data-readout="elevation" />
              </figcaption>
              <div class="chart__plot" set:html={eleChart} />
            </figure>
            <figure class="chart" data-chart-kind="speed">
              <figcaption class="chart__cap">
                <span class="chart__title">Speed</span>
                <output class="chart__readout" data-readout="speed" />
              </figcaption>
              <div class="chart__plot" set:html={speedChart} />
            </figure>
          </section>

          <div class="tiles detail-tiles">
            {tiles.map((t) => (
              <div class="card tile">
                <div class="v">{t.value}</div>
                <div class="l">{t.label}</div>
              </div>
            ))}
          </div>

          <details class="more detail-more">
            <summary>More stats & splits</summary>

            <div class="disclosure-grid">
              <section class="disclosure-block">
                <h2>Details</h2>
                <dl class="statlist">
                  {secondary.map((s) => (
                    <>
                      <dt>{s.label}</dt>
                      <dd>{s.value}</dd>
                    </>
                  ))}
                </dl>
              </section>

              <section class="disclosure-block">
                <h2>Fastest windows</h2>
                <dl class="statlist">
                  {windows.map((w) => (
                    <>
                      <dt>{w.label}</dt>
                      <dd>{w.value}</dd>
                    </>
                  ))}
                </dl>
              </section>
            </div>

            <section class="disclosure-block">
              <h2>Splits</h2>
              <table class="splits">
                <thead>
                  <tr>
                    <th>Km</th>
                    <th>Distance</th>
                    <th>Time</th>
                    <th>Speed</th>
                    <th>Elev</th>
                    <th>Gradient</th>
                  </tr>
                </thead>
                <tbody>
                  {splits.map((s) => (
                    <tr>
                      <td>{s.km}</td>
                      <td>{s.dist}</td>
                      <td>{s.time}</td>
                      <td>{s.speed}</td>
                      <td>{s.ele}</td>
                      <td>{s.grad}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </section>
          </details>

          <div class="detail-actions">
            <a class="btn" href={`/compare?a=${encodeURIComponent(ride.id)}`}>Compare…</a>
            <span class="spacer" />
            <button id="delete-btn" class="btn danger" type="button" data-id={ride.id}>
              Delete ride
            </button>
            <span id="delete-status" class="delete-status" aria-live="polite" />
          </div>
          </div>
        </>
      )
    }
  </main>
</Layout>

<script>
  // Upgrade the static hero to a live 2D-follow map with playback (ticket 4b).
  import { mountRidePlayback } from '../../scripts/ride-playback';
  mountRidePlayback();
</script>

<script>
  // Delete behind a confirmation → the Worker delete endpoint. On success the
  // ride is gone from D1/R2 and records self-heal, so we return to the library.
  const btn = document.getElementById('delete-btn') as HTMLButtonElement | null;
  const status = document.getElementById('delete-status');
  if (btn) {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.id;
      if (!id) return;
      if (!confirm('Delete this ride? This cannot be undone.')) return;

      btn.disabled = true;
      if (status) status.textContent = 'Deleting…';
      try {
        const res = await fetch(`/api/rides/${encodeURIComponent(id)}`, { method: 'DELETE' });
        if (!res.ok) {
          let reason = `server responded ${res.status}`;
          try {
            const body = (await res.json()) as { error?: string };
            if (body?.error) reason = body.error;
          } catch {
            /* non-JSON error body — keep the status line */
          }
          throw new Error(reason);
        }
        window.location.href = '/';
      } catch (err) {
        btn.disabled = false;
        if (status) status.textContent = err instanceof Error ? err.message : String(err);
      }
    });
  }
</script>
